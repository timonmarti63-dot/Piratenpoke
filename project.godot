; Godot 4 Projektdatei — Piratenpoke
; Engine wird beim ersten Öffnen in Godot 4.x weitere Felder automatisch ergänzen.

config_version=5

[application]

config/name="Piratenpoke"
config/description="2D-Top-Down-Piraten-RPG im Pokémon-Stil mit rundenbasiertem Kampfsystem."
config/features=PackedStringArray("4.2", "GL Compatibility")
run/main_scene="res://scenes/world/world.tscn"

[autoload]

GameConfig="*res://scripts/core/game_config.gd"
InputBuffer="*res://scripts/core/input_buffer.gd"
TypeChart="*res://scripts/core/type_chart.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
Inventory="*res://scripts/core/inventory.gd"
VillageState="*res://scripts/core/village_state.gd"
Bootstrap="*res://scripts/core/bootstrap.gd"

[display]

; Fenster passt zu 64x64 Kacheln: 16x9 Kacheln sichtbar = 1024x576, skaliert auf 1280x720
window/size/viewport_width=1024
window/size/viewport_height=576
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"

